# Copiar a .env (no publicar el archivo .env en GitHub)
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_LARGA_ALEATORIA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Primera ejecución: sqlite. Para base de datos con usuario/permisos usar postgresql o mariadb.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# Para postgres/mariadb cambiar DB_ENGINE, DB_NAME y estas credenciales:
DB_USER=gestor_tareas_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_REAL
DB_HOST=127.0.0.1
DB_PORT=5432
